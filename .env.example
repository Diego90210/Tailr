# Tailr environment contract — copy to `.env` and fill in.
# Source: docs/technical_requirements.md §21. Real values are never committed (TR-ENV-2).
# Only vars marked REQUIRED in apps/web/lib/env.ts fail the boot; the rest have safe
# defaults or belong to features that are not shipped yet.

# Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only

# LLM providers (only the ones in use)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# LLM routing
# Groq routes use openai/gpt-oss-120b: the free-tier model that supports strict json_schema (SPIKE-02).
# Only ZDR-approved providers may appear here (backend_schema.md §8.1): the Gemini free tier
# trains on content and OpenRouter depends on the upstream provider, so neither is approved yet.
LLM_ROUTE_EXTRACT_PROFILE=groq:openai/gpt-oss-120b
LLM_ROUTE_ANALYZE_JD=groq:openai/gpt-oss-120b
LLM_ROUTE_GAP_QUESTIONS=groq:openai/gpt-oss-120b
LLM_ROUTE_REWRITE_BULLETS=groq:openai/gpt-oss-120b
LLM_ROUTE_CLASSIFY_FACTS=groq:openai/gpt-oss-120b
LLM_FALLBACK_CHAIN=groq

# Limits and cost
RATE_LIMIT_ENABLED=true
CONFIDENCE_THRESHOLD=0.95
DAILY_TOKEN_BUDGET=
DAILY_TOKEN_HARD_CAP=
PAYLOAD_MAX_JD_CHARS=20000
PAYLOAD_MAX_CV_CHARS=100000

# BYO-key (RF-15.22–RF-15.27)
BYO_KEY_ENCRYPTION_KEY=             # 32 bytes, base64; required if BYO-key is enabled
ENABLE_BYO_KEY=true

# Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Docgen service
DOCGEN_URL=
DOCGEN_SHARED_SECRET=

# Feature flags
ENABLE_GUEST_MODE=true
DEGRADED_MODE=false
